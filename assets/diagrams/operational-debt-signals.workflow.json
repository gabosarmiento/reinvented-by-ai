    { "id": "record-views", "from": "record", "to": "views", "variant": "emphasis" },
    { "id": "views-alerts", "from": "views", "to": "alerts", "variant": "security" },
    { "id": "trace-outcome", "from": "trace", "to": "outcome", "label": "claimed completion", "variant": "security", "role": "branch" },
    { "id": "outcome-record", "from": "outcome", "to": "record", "label": "observed result", "variant": "emphasis", "role": "return" }
  ]
