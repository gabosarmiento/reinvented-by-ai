    { "id": "approval-action", "from": "approval", "to": "action", "variant": "emphasis" },
    { "id": "action-evidence", "from": "action", "to": "evidence", "variant": "emphasis" },
    { "id": "classify-preauth", "from": "classify", "to": "preauth", "label": "inside limits", "variant": "dashed", "role": "branch" },
    { "id": "preauth-evidence", "from": "preauth", "to": "evidence", "variant": "dashed", "role": "branch" },
    { "id": "classify-human", "from": "classify", "to": "human", "label": "reserved decision", "variant": "security", "role": "branch" },
    { "id": "human-evidence", "from": "human", "to": "evidence", "variant": "security", "role": "return" }
