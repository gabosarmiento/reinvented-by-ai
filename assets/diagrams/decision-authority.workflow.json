      { "from": "classify", "to": "human" }
    ]
  },
  "nodes": [
    { "id": "trigger", "lane": "design", "col": 0, "type": "external", "label": "Decision Trigger", "sublabel": "a commitment is due", "width": 155 },
    { "id": "spec", "lane": "design", "col": 1, "type": "backend", "label": "Decision Specification", "sublabel": "inputs · objective · deadline", "width": 165 },
    { "id": "classify", "lane": "design", "col": 2, "type": "security", "label": "Consequence + Reversibility", "sublabel": "defines the authority envelope", "width": 180 },
    { "id": "approval", "lane": "delegated", "col": 3, "type": "security", "label": "Approval Gate", "sublabel": "required condition met?", "tag": "SUPERVISED", "width": 155 },
    { "id": "preauth", "lane": "delegated", "col": 4, "type": "backend", "label": "Pre-authorized Action", "sublabel": "inside explicit limits", "tag": "AUTONOMOUS", "width": 165 },
    { "id": "action", "lane": "delegated", "col": 4, "type": "messagebus", "label": "Bounded Action", "sublabel": "execute or stop", "width": 155, "yOffset": 88 },
    { "id": "human", "lane": "reserved", "col": 3, "type": "external", "label": "Human Decision", "sublabel": "agent prepares evidence", "tag": "RESERVED", "width": 155 },
    { "id": "evidence", "lane": "delegated", "col": 5, "type": "database", "label": "Decision Evidence", "sublabel": "authority · rationale · outcome", "width": 165 }
